  "claim_model": {
    "block_timestamp_claim": "A preserved and cryptographically verified inclusion/finality proof can show that a commitment was included in an Ethereum mainnet block assigned to a consensus slot/time. It is not an absolute real-world clock attestation.",
    "levels": {
      "L1_BYTE_INTEGRITY": "PASS only when every declared preserved payload has the recorded size and SHA-256.",
      "L2_EXECUTION_INCLUSION": "PASS only when transaction/receipt inclusion can be verified against preserved execution block roots. RPC/explorer lookup alone is REFERENCE_CHECKED, not PASS.",
      "L3_CONSENSUS_FINALITY": "PASS only when the execution block is linked to preserved Ethereum PoS finality material and the documented trust checkpoint. A claimed finality status without proof material is not PASS."
    },
    "trusted_checkpoint_rule": "Ethereum light-client verification requires an explicitly documented trusted finalized checkpoint/root. The annex must not hide or manufacture that trust assumption."
  },
  "source_registries": [
    "archive/legacy-pointers/index.json",
    "archive/legacy-pointers/eth-raw/metadata.json",
    "api/evidence-manifest.json",
    "archive/eth-witness/eth-witness.json"
  ],
  "proof_material_policy": {
    "transaction_json": "required_for_L2",
    "receipt_json": "required_for_L2",
    "execution_block_header": "required_for_L2",
    "transaction_or_receipt_inclusion_proof": "required_for_L2",
    "beacon_finality_material": "required_for_L3",
    "trusted_finalized_checkpoint": "required_for_L3",
    "current_v1_note": "This first annex inventories and verifies preserved byte bindings and known chain references. Missing execution/consensus proof objects are explicitly UNVERIFIED, never inferred from historical RPC checks."
  },
