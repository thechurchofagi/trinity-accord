  "authority_boundary": {
    "canonical_authority": "three Bitcoin Originals only",
    "ethereum_role": "non-amending consensus witness and historical commitment-time evidence",
    "no_authority_escalation": true
  },
  "claim_model": {
    "block_timestamp_claim": "A preserved and cryptographically verified inclusion/finality proof can show that a commitment was included in an Ethereum mainnet block assigned to a consensus slot/time. It is not an absolute real-world clock attestation.",
    "levels": {
      "L1_BYTE_INTEGRITY": "PASS only when every declared preserved payload has the recorded size and SHA-256.",
      "L2_EXECUTION_INCLUSION": "PASS only when preserved raw signed transactions and encoded receipts independently reconstruct the execution block transactionsRoot/receiptsRoot and the execution header recomputes to the declared block hash.",
      "L3_CONSENSUS_FINALITY": "PASS only when the execution block hash is SSZ-proven into the target Beacon block body and that target Beacon root is linked by verified parent-root ancestry to an explicitly declared trusted finalized descendant Beacon root under the documented weak-subjectivity assumption."
    },
    "trusted_checkpoint_rule": "L3 PASS is checkpoint-relative: the annex explicitly names the trusted finalized Beacon root for each anchor. Cross-provider canonical/finalized API observations are preserved as provenance only and never replace the weak-subjectivity trust assumption."
  },
  "source_registries": [
    "archive/legacy-pointers/index.json",
    "archive/legacy-pointers/eth-raw/metadata.json",
    "api/evidence-manifest.json",
    "archive/eth-witness/eth-witness.json"
  ],
  "proof_material_policy": {
    "transaction_json": "required_for_L2",
    "receipt_json": "required_for_L2",
    "execution_block_header": "required_for_L2",
    "transaction_or_receipt_inclusion_proof": "full deterministic trie reconstruction witness accepted: all raw signed transactions and encoded receipts reconstruct the committed roots offline",
    "beacon_finality_material": "SSZ execution-block-hash branch plus Beacon header parent-root ancestry to an explicit trusted finalized descendant root",
    "trusted_finalized_checkpoint": "explicit per-anchor trusted finalized Beacon root under weak subjectivity",
    "current_v1_note": "All 12 evidence-bearing self-addressed non-NFT anchors now preserve byte-bound L2 execution reconstruction witnesses and L3 checkpoint-relative Beacon consensus witnesses. Historical RPC capture files remain reference-only and are not the basis of L2/L3 PASS.",
    "rpc_history_capture": "PRESERVED_FOR_ALL_12_ANCHORS_REFERENCE_ONLY",
    "rpc_history_capture_boundary": "Preserving transaction/receipt/block JSON freezes the observed Ethereum block timestamp and commitment context, but does not upgrade L2/L3 without independent inclusion/finality proof validation.",
    "execution_reconstruction_witness": "PRESERVED_AND_SHA256_BOUND_FOR_ALL_12_ANCHORS",
    "beacon_consensus_witness": "PRESERVED_AND_SHA256_BOUND_FOR_ALL_12_ANCHORS",
    "offline_verifier": "evidence/ethereum-evidence-annex-v1/verification/verify_annex.py",
