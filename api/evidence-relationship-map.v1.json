    "defines_canonical_text": "Defines canonical content and authority boundary.",
    "references": "Names or points to another record without copying its authority.",
    "indexes": "Collects identifiers, hashes, status and pointers into one manifest.",
    "hashes": "Binds exact bytes to one or more digest values.",
    "signs_digest": "A cryptographic key signs a digest or typed digest statement.",
    "timestamps_digest": "Anchors a digest into a blockchain time proof.",
    "mirrors_bytes": "Preserves bytes for later retrieval; does not create authority.",
    "witnesses_statement": "Places a statement or reference on another public chain.",
    "notarially_records_process": "Records an observed process within the scope of a notarial act.",
    "provides_context": "Preserves historical, creative or interpretive context without proving external facts.",
    "records_reception": "Records later reception, critique, refusal, verification attempts or stewardship events.",
    "proves_chain_binding": "Recomputes a content, transaction, witness, block-header and ancestry binding from preserved cryptographic proof bytes.",
    "proves_execution_and_consensus_binding": "Recomputes transaction/receipt trie inclusion, execution-header binding and declared-checkpoint-relative consensus ancestry.",
    "freezes_exact_git_baseline": "Preserves every Git-tracked byte and executable mode for one named immutable publication baseline.",
    "supplies_external_payloads": "Provides large binary payloads referenced by the core repository but intentionally stored in a separate recovery capsule.",
    "hosts_moving_source": "Hosts a current development and discovery surface whose exact identity must be named by commit SHA.",
    "mirrors_capsule": "Preserves a named capsule payload without becoming canonical authority or automatically tracking later versions.",
    "mirrors_historical_capsule": "Preserves an explicitly historical capsule and must not be read as coverage of the current DOI version.",
    "guides_future_refresh": "Records review triggers, completed work and authorization boundaries; it is maintenance guidance rather than proof."
  },
