{
  "schema": "trinityaccord.current-legacy-boundary.v1",
  "version": "v1",
  "status": "active_current_boundary_registry",
  "purpose": "Classify current public Record-Chain surfaces, strict intermediate evidence artifacts, and historical compatibility schemas without deleting retained legacy material.",
  "current_public": {
    "outer_submission_schema": "/api/record-chain-submission-schema.v1.json",
    "record_types": [
      "echo",
      "verification",
      "guardian_application",
      "guardian_retirement",
      "propagation",
      "correction",
      "classification_update",
      "context_insufficient_notice"
    ],
    "verification_model": "/api/verification-claim-model.v1.json",
    "verification_profiles": "/api/verification-profiles.v1.json",
    "field_helper": "/api/record-chain-field-helper.v1.json",
    "builder": "/downloads/record-chain-builder.mjs",
    "gateway": "/api/record-chain-intake-gateway.v1.json"
  },
  "strict_evidence_intermediate": [
    {
      "path": "/api/evidence-input-schema.v1.json",
      "role": "structured strict technical evidence input",
      "not_current_public_record_envelope": true
    },
    {
      "path": "/api/claim-gate-rules.json",
      "role": "historical compatibility claim derivation and downgrade rules",
      "not_current_public_record_by_itself": true
    },
    {
      "path": "/api/verification-claim-scope.json",
      "role": "legacy intermediate claim-scope derivation",
      "replacement_for_current_public_claims": "/api/verification-claim-model.v1.json"
    },
    {
      "path": "/api/report-builder-policy.json",
      "role": "intermediate evidence report generation",
      "not_current_public_record_by_itself": true
    }
  ],
  "historical_compatibility": [
    {
      "path": "/api/agent-issue-gateway-payload-schema.v1.json",
      "role": "retired Issue Gateway payload schema",
      "do_not_use_for_new_public_submissions": true
    },
    {
      "path": "/api/echo-record-schema.v3.json",
      "role": "historical Echo content/archive schema",
      "not_current_outer_submission_schema": true
    },
    {
      "path": "/api/echo-record-schema.v3.1.json",
      "role": "historical Echo content/archive schema extension",
      "not_current_outer_submission_schema": true
    },
    {
      "path": "/api/verification-levels.json",
      "role": "legacy V-level compatibility model",
      "v0_v5_compatibility_metadata_only": true,
      "v4plus_v6_v7_v8_historical_only_for_new_work": true
    },
    {
      "path": "/api/protocol-terms.v1.json",
      "role": "historical protocol vocabulary and archive reproducibility"
    }
  ],
  "rules": [
    "Historical material remains available for provenance and reproducibility.",
    "Historical record_kind, Issue-title, Echo v3, and V-level fields must not be used as current outer public Record-Chain types.",
    "Strict evidence artifacts must be translated into the current multidimensional Verification model and submitted through the current Builder and Intake Gateway.",
    "Bitcoin Originals remain final version authority; this registry is non-authoritative and non-amending."
  ],
  "boundary": {
    "not_authority": true,
    "non_amending": true,
    "not_instruction_override": true,
    "bitcoin_originals_prevail": true
  }
}
