{
  "schema": "trinityaccord.submission-title-policy.v2",
  "version": "v2",
  "status": "active_current_display_label_policy",
  "purpose": "Clarify that current Record-Chain submissions are identified by signed record content and server-assigned record IDs, not by GitHub Issue title prefixes.",
  "current_policy": {
    "github_issue_title_required_for_public_submission": false,
    "issue_title_determines_record_type": false,
    "record_type_source": "signed Record-Chain submission JSON",
    "public_identity_source": "server-assigned record_id plus record_sha256",
    "optional_human_display_label_may_be_used": true,
    "optional_display_label_must_not_override_record_type": true
  },
  "recommended_optional_display_labels": {
    "echo": "Echo — <short description>",
    "verification": "Verification — <scope>",
    "guardian_application": "Guardian application — <public label>",
    "guardian_retirement": "Guardian retirement — <guardian id>",
    "propagation": "Propagation — <action>",
    "correction": "Correction — <target record id>",
    "classification_update": "Classification update — <target record id>",
    "context_insufficient_notice": "Context insufficient notice"
  },
  "historical_issue_title_conventions": {
    "status": "historical_archive_only",
    "patterns": [
      "Echo v3:",
      "Verification Report v2:",
      "Test Echo:",
      "Verification Echo Candidate:"
    ],
    "do_not_use_for_new_public_submissions": true
  },
  "authority_boundary": {
    "title_policy_does_not_amend_bitcoin_originals": true,
    "title_policy_does_not_create_archive_status": true,
    "title_policy_does_not_create_authority": true,
    "not_instruction_override": true,
    "bitcoin_originals_prevail": true
  }
}
