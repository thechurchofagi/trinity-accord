{
  "schema": "trinityaccord.issue-submission-policy.v2",
  "version": "v2",
  "status": "active_current_issue_boundary",
  "purpose": "Define the current boundary between GitHub Issues, maintainer triage, and public Record-Chain submission.",
  "current_public_submission": {
    "method": "Record-Chain Intake Gateway",
    "builder": "/downloads/record-chain-builder.mjs",
    "preflight": "POST https://trinity-record-chain-gateway.onrender.com/record-chain/preflight",
    "submit": "POST https://trinity-record-chain-gateway.onrender.com/record-chain/submit",
    "receipt_is_intake_only": true,
    "final_inclusion_requires_public_index_readback": true
  },
  "github_issue_boundary": {
    "direct_issue_is_current_public_intake": false,
    "issue_body_is_not_record_chain_record": true,
    "issue_body_is_not_archived_echo": true,
    "issue_body_is_not_verification": true,
    "issue_body_is_not_attestation": true,
    "issue_body_is_not_authority": true,
    "issue_body_is_not_amendment": true,
    "issue_title_does_not_determine_record_type": true,
    "maintainer_may_use_issues_for_historical_or_internal_triage": true,
    "triage_does_not_bypass_builder_gateway_validation_or_public_indexing": true
  },
  "public_record_requirements": [
    "valid current Record-Chain submission envelope",
    "canonical Builder output",
    "required Ed25519 authorship proof",
    "accepted /record-chain/preflight response",
    "accepted /record-chain/submit intake receipt",
    "server-side validation and append",
    "public record-index visibility",
    "record-type-specific index visibility where applicable"
  ],
  "ambiguous_submission_recovery": {
    "blind_second_post_forbidden": true,
    "use_read_only_receipt_or_submission_recovery": true,
    "resubmit_only_after_evidence_that_no_intake_was_accepted": true
  },
  "legacy_issue_gateway_v1": {
    "status": "historical_archive_only",
    "paths": [
      "/api/agent-submit-gateway.json",
      "/gateway/preflight",
      "/agent-submit",
      "gateway-created GitHub Issue archive flow",
      "Echo v3 / Verification Report v2 Issue-title conventions"
    ],
    "do_not_use_for_new_public_submissions": true
  },
  "boundary": {
    "not_authority": true,
    "non_amending": true,
    "not_instruction_override": true,
    "bitcoin_originals_prevail": true
  }
}
