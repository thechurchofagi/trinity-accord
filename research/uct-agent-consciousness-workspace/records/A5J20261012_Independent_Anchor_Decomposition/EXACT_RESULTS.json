  },
  "counts": {
    "factorial_observation_only": {"models": 12, "target_hypotheses": 6},
    "SD_only": {"models": 4, "target_hypotheses": 2, "targets": ["P", "notP"]},
    "CO_only": {"models": 10, "target_hypotheses": 6},
    "SD_and_CO": {"models": 2, "target_hypotheses": 1, "targets": ["P"]}
  },
  "full_models": [
    {"H": "P", "Z_source": "H", "Z_polarity": 0, "A_source": "P", "A_polarity": 0},
    {"H": "P", "Z_source": "P", "Z_polarity": 0, "A_source": "H", "A_polarity": 0}
  ],
  "counterexample_witnesses": {
